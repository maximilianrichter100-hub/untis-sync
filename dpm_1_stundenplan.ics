import re
import requests
from datetime import datetime
from icalendar import Calendar, Event

# ==========================================
# KONFIGURATION
# ==========================================
# Ersetze diesen Link mit deiner originalen Untis / SPLAN Webcal- bzw. ICS-URL:
UNTIS_ICS_URL = "DEINE_UNTIS_ICS_URL_HIER"
OUTPUT_FILE = "calendar_fixed.ics"

# Korrekte Blockzeiten (Startzeit -> feste Endzeit)
CORRECT_BLOCK_TIMES = {
    ("08", "00"): ("09", "30"),
    ("09", "45"): ("11", "15"),
    ("11", "30"): ("13", "00"),  # <-- HIER KORRIGIERT: 13:00 Uhr statt 13:15 Uhr!
    ("13", "30"): ("15", "00"),
    ("15", "15"): ("16", "45"),
    ("17", "00"): ("18", "30"),
}

def fix_calendar():
    print("Lade Kalenderdaten herunter...")
    if UNTIS_ICS_URL.startswith("http"):
        response = requests.get(UNTIS_ICS_URL.replace("webcal://", "https://"))
        response.raise_for_status()
        raw_data = response.content
    else:
        with open("calendar.ics", "rb") as f:
            raw_data = f.read()

    cal = Calendar.from_ical(raw_data)
    fixed_cal = Calendar()

    # Kalender-Kopfdaten übernehmen
    for key, value in cal.items():
        if key not in ["BEGIN", "END"]:
            fixed_cal.add(key, value)

    count_fixed = 0

    for component in cal.walk():
        if component.name == "VEVENT":
            event = component

            dtstart = event.get("dtstart")
            dtend = event.get("dtend")

            if dtstart and dtend:
                start_dt = dtstart.dt
                end_dt = dtend.dt

                # Prüfen, ob es sich um ein DateTime-Objekt handelt
                if isinstance(start_dt, datetime):
                    start_key = (f"{start_dt.hour:02d}", f"{start_dt.minute:02d}")

                    # 1. Fall: Explizite Korrektur des 11:30–13:15 Fehlers
                    if start_key == ("11", "30") and end_dt.hour == 13 and end_dt.minute == 15:
                        new_end_dt = end_dt.replace(hour=13, minute=0)
                        event["dtend"].dt = new_end_dt
                        count_fixed += 1

                    # 2. Fall: Generelle Standardisierung aller Blöcke auf saubere 90 Minuten
                    elif start_key in CORRECT_BLOCK_TIMES:
                        target_h, target_m = CORRECT_BLOCK_TIMES[start_key]
                        new_end_dt = end_dt.replace(hour=int(target_h), minute=int(target_m))
                        event["dtend"].dt = new_end_dt

            fixed_cal.add_component(event)
        elif component.name not in ["VCALENDAR"]:
            fixed_cal.add_component(component)

    with open(OUTPUT_FILE, "wb") as f:
        f.write(fixed_cal.to_ical())

    print(f"Fertig! {count_fixed} Vorlesungen von 13:15 Uhr auf 13:00 Uhr korrigiert.")
    print(f"Gespeichert in: {OUTPUT_FILE}")

if __name__ == "__main__":
    fix_calendar()
